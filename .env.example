# URL publica
NEXT_PUBLIC_SITE_URL=https://www.altumia.com.br
NEXT_PUBLIC_APP_URL=https://www.altumia.com.br
APP_URL=https://www.altumia.com.br
NEXT_PUBLIC_SITE_UPDATED_AT=2026-08-27T00:00:00-03:00
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Firebase Web SDK (publicos por natureza; a seguranca vem de Auth + Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Chave publica Web do reCAPTCHA Enterprise registrada no Firebase App Check.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin (segredos somente no servidor)
# Formato recomendado na Vercel: JSON completo em uma unica variavel.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternativa: use as tres variaveis abaixo em vez do JSON completo.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# E-mails transacionais de autenticacao (somente servidor)
# Use uma chave Resend exclusiva, com permissao apenas de envio e restrita ao dominio.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Altum <conta@altumia.com.br>"
AUTH_EMAIL_REPLY_TO=suporte.altum@gmail.com

# Asaas: use sandbox ate concluir os testes ponta a ponta
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Criptografia de segredos de integracoes armazenados pela aplicacao
SECRET_ENCRYPTION_KEY=

# Processamento confiavel de midias do chat. Em producao, use CRON_SECRET
# (ou um token dedicado) no agendador que chama a rota interna de recuperacao.
CRON_SECRET=
CHAT_OUTBOUND_PROCESS_TOKEN=
