# URL publica
NEXT_PUBLIC_SITE_URL=https://www.altumia.com.br
NEXT_PUBLIC_APP_URL=https://www.altumia.com.br
APP_URL=https://www.altumia.com.br
NEXT_PUBLIC_SITE_UPDATED_AT=2026-08-27T00:00:00-03:00
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics publicos (IDs de medicao, nao sao chaves secretas)
# GA4: Administracao > Fluxos de dados > Web > ID da medicao (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Opcional: pixel da Meta. Deixe vazio se nao for usar.
NEXT_PUBLIC_META_PIXEL_ID=

# Firebase Web SDK (publicos por natureza; a seguranca vem de Auth + Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Chave publica Web do reCAPTCHA Enterprise registrada no Firebase App Check.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin (segredos somente no servidor)
# Formato recomendado na Vercel: JSON completo em uma unica variavel.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternativa: use as tres variaveis abaixo em vez do JSON completo.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# IA da operacao (somente servidor). Os modelos abaixo priorizam baixo custo.
OPENAI_API_KEY=
OPENAI_BUSINESS_INSIGHTS_MODEL=gpt-4.1-nano
OPENAI_MEETING_SUMMARY_MODEL=gpt-4.1-nano
OPENAI_MEETING_COACH_MODEL=gpt-4.1-nano
OPENAI_MEETING_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Bots de reuniao self-hosted (gateway privado, baseado no Vexa open source).
# Rode o gateway em infraestrutura controlada pela Altum; nunca exponha a chave no navegador.
ALTUM_MEETING_BOT_API_URL=http://meeting-gateway:18056
ALTUM_MEETING_BOT_API_KEY=
ALTUM_MEETING_BOT_NAME="Altum IA"

# E-mails transacionais de autenticacao (somente servidor)
# Use uma chave Resend exclusiva, com permissao apenas de envio e restrita ao dominio.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Altum <conta@altumia.com.br>"
AUTH_EMAIL_REPLY_TO=suporte.altum@gmail.com

# Google Ads OAuth. O nivel de acesso fica associado ao projeto Google Cloud.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Compatibilidade legada; opcional desde a migracao de acesso do Google Ads em 2026.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# Asaas: use sandbox ate concluir os testes ponta a ponta
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Criptografia de segredos de integracoes armazenados pela aplicacao
SECRET_ENCRYPTION_KEY=

# Processamento confiavel de midias do chat. Em producao, use CRON_SECRET
# (ou um token dedicado) no agendador que chama a rota interna de recuperacao.
CRON_SECRET=
CHAT_OUTBOUND_PROCESS_TOKEN=

# MCP Altum command center (leitura local/remota; desligado por padrao)
ALTUM_MCP_ENABLED=false
# Segredo HMAC com pelo menos 32 caracteres, exclusivo do MCP.
MCP_CONTEXT_SECRET=
# JSON: [{"userId":"firebase_uid","tenantId":"tenant_id","scopes":["context:read","crm:read","inbox:read","reports:read","integrations:read","events:read","ai:draft"],"expiresAt":"2026-12-31T23:59:59.000Z"}]
MCP_READ_GRANTS=[]
# Dominio publico HTTPS usado pelo MCP remoto/OAuth (ChatGPT web, clientes MCP remotos).
ALTUM_PUBLIC_URL=
# Usado pelo cliente MCP local em modo real. O arquivo deve conter um Firebase ID token valido.
ALTUM_MCP_BASE_URL=http://localhost:3000
ALTUM_MCP_TOKEN_FILE=
