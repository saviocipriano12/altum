{
  "name": "altum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && npx tsc -p tsconfig.release.json --noEmit --incremental false",
    "altum:audit": "node scripts/run-altum-quality-suite.mjs",
    "altum:audit:full": "node scripts/run-altum-quality-suite.mjs --full",
    "altum:audit:security": "node scripts/run-altum-quality-suite.mjs --security",
    "altum:audit:client-map": "node scripts/audit-client-connections.mjs",
    "test:smoke": "node scripts/run-smoke-tests.mjs",
    "test:firebase-rules": "npx --yes firebase-tools@15.29.0 emulators:exec --only firestore,storage --project demo-altum-rules \"npm run test:firebase-rules:run\"",
    "test:firebase-rules:run": "node --test --experimental-strip-types tests/firebase-rules.emulator.mts",
    "check:saas-readiness": "node scripts/check-saas-readiness.mjs",
    "verify:postdeploy": "node scripts/post-deploy-verify.mjs",
    "test:agent-closure": "node scripts/run-agent-closure-gate.mjs",
    "test:ai-quality": "node --import tsx --test tests/ai-evaluation.test.mts tests/ai-evaluation-proof.test.mts tests/ai-operational-plan.test.mts tests/ai-observability-smoke.test.mts tests/ai-conversation-policy.test.mts tests/ai-conversation-rollout.test.mts tests/ai-rollout-quality-gate.test.mts tests/ai-voice-policy.test.mts tests/ai-tenant-context.test.mts tests/ai-knowledge-context.test.mts tests/commercial-offer.test.mts tests/commercial-visual-match.test.mts",
    "test:ai-live-roles": "node --import tsx scripts/verify-ai-role-live.mts",
    "test:ai-live-voice": "node --import tsx scripts/verify-ai-voice-live.mts",
    "test:ai-queue-emulator": "npx --yes firebase-tools@15.29.0 emulators:exec --only firestore --project demo-altum-ai-queue \"node --import tsx --test tests/ai-queue.emulator.mts\"",
    "firestore:indexes:deploy": "node scripts/deploy-firestore-indexes.mjs",
    "firebase:rules:inspect": "node scripts/inspect-firebase-rules.mjs",
    "firebase:rules:validate": "node scripts/validate-firebase-rules.mjs",
    "firebase:rules:deploy": "node scripts/deploy-firebase-rules.mjs --apply",
    "outbound:queue:check": "node scripts/check-outbound-jobs.mjs",
    "migrate:ownership": "node scripts/migrate-users-ownership.mjs",
    "cliente:demo:seed": "node scripts/seed-client-demo.mjs",
    "push:vapid": "web-push generate-vapid-keys",
    "cliente:onboarding:new": "node scripts/new-client-onboarding.mjs",
    "mcp:start": "node --import tsx scripts/mcp/server.ts",
    "mcp:demo": "node --import tsx scripts/mcp/demo.ts",
    "test:mcp": "node --import tsx --test tests/mcp-command-center.test.mts tests/mcp-oauth-contract.test.mts tests/adport-connectors.test.mts",
    "test:growth": "node --import tsx --test tests/growth-tracking.test.mts tests/revenue-graph.test.mts tests/google-ads-operator.test.mts tests/google-ads-actions.test.mts tests/meta-ads-operator.test.mts tests/meta-ads-actions.test.mts"
  },
  "dependencies": {
    "@adport/core": "0.6.0",
    "@adport/provider-google": "0.6.0",
    "@adport/provider-meta": "0.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.120",
    "cmdk": "^1.1.1",
    "emoji-picker-react": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.23.22",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.545.0",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.7.0",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.25.0",
    "stripe": "^22.2.3",
    "web-push": "^3.6.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "fast-xml-parser": "^5.7.0",
    "node-forge": "^1.4.0",
    "yaml": "^2.8.3",
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^4.2.1",
    "ip-address": "^10.7.3",
    "@tootallnate/once": "^3.0.1",
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.5",
    "uuid": "^11.1.1"
  }
}
