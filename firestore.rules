rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myUid()));
    }

    function myRole() {
      return myUserDoc().data.role;
    }

    function myStatus() {
      return myUserDoc().data.status;
    }

    function isActive() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(myUid())) &&
        myStatus() == "active";
    }

    function isAgencyAdmin() {
      return isActive() && (
        myRole() == "admin" ||
        myRole() == "agency_owner" ||
        myRole() == "agency_admin"
      );
    }

    function isAgencyMember() {
      return isActive() && (
        isAgencyAdmin() ||
        myRole() == "agency_agent" ||
        myRole() == "closer" ||
        myRole() == "sdr"
      );
    }

    function isClientPanelRole() {
      return isActive() && (
        myRole() == "client" ||
        myRole() == "client_owner" ||
        myRole() == "client_admin" ||
        myRole() == "client_agent" ||
        myRole() == "client_viewer"
      );
    }

    function isAdmin() {
      return isAgencyAdmin();
    }

    function isSelf(uid) {
      return signedIn() && uid == myUid();
    }

    function isOwner(ownerId) {
      return isActive() && ownerId == myUid();
    }

    function hasTenantMembership(tenantId) {
      return isActive() &&
        tenantId is string &&
        exists(/databases/$(database)/documents/tenant_users/$(tenantId + "_" + myUid())) &&
        get(/databases/$(database)/documents/tenant_users/$(tenantId + "_" + myUid())).data.status == "active";
    }

    function tenantMembership(tenantId) {
      return get(/databases/$(database)/documents/tenant_users/$(tenantId + "_" + myUid()));
    }

    function canManageTenant(tenantId) {
      return isAgencyAdmin() || (
        hasTenantMembership(tenantId) && (
          tenantMembership(tenantId).data.role == "client_owner" ||
          tenantMembership(tenantId).data.role == "client_admin"
        )
      );
    }

    function tenantIdIsUnchanged() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }

    function ownerIdIsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // A API do painel aplica a mesma regra no servidor. Estas regras existem
    // para impedir que um atendente contorne a API consultando o Firestore
    // diretamente e leia a carteira de outro vendedor.
    function isTenantCommercialManager(tenantId) {
      return hasTenantMembership(tenantId) && (
        tenantMembership(tenantId).data.role == "client_owner" ||
        tenantMembership(tenantId).data.role == "client_admin"
      );
    }

    function recordAssignedToMe(record) {
      return (record.keys().hasAny(["assignedTo"]) && record.assignedTo == myUid()) ||
        (record.keys().hasAny(["ownerId"]) && record.ownerId == myUid()) ||
        (record.keys().hasAny(["ownerUserId"]) && record.ownerUserId == myUid()) ||
        (record.keys().hasAny(["assignedUserId"]) && record.assignedUserId == myUid()) ||
        (record.keys().hasAny(["responsavelId"]) && record.responsavelId == myUid());
    }

    function canReadCommercialRecord(tenantId, record) {
      return isAgencyMember() || isTenantCommercialManager(tenantId) || (
        hasTenantMembership(tenantId) && recordAssignedToMe(record)
      );
    }

    function canWriteCommercialRecord(tenantId) {
      return isAgencyMember() || isTenantCommercialManager(tenantId);
    }

    // Server-managed rollout: old tenants keep their existing SDK contract.
    function requiresTaskIndexWrites(tenantId) {
      let path = /databases/$(database)/documents/tenant_entitlements/$(tenantId);
      let control = getAfter(path);
      return control != null && control.data.get('taskIndexWriteProtocol', 0) == 1;
    }

    function normalizedTaskState(record) {
      let status = record.get('status', 'pending');
      return status in ['done', 'completed'] ? 'done' :
        status in ['canceled', 'cancelled', 'no_show'] ? 'canceled' :
        status == 'draft' ? 'suggested' : 'pending';
    }

    function validTaskIndexShape(record) {
      let index = record.get('crmTaskIndex', {});
      let status = record.get('status', 'pending');
      return index is map &&
        index.keys().hasAll(['version', 'state', 'openRank', 'dueOrder', 'issue']) &&
        index.keys().hasOnly(['version', 'state', 'openRank', 'dueOrder', 'issue']) &&
        index.version == 1 && index.issue == null && index.dueOrder is int &&
        status is string && status in ['pending', 'done', 'completed', 'canceled', 'cancelled', 'no_show', 'draft'] &&
        index.state == normalizedTaskState(record) &&
        index.openRank == (index.state == 'pending' ? 0 : 1);
    }

    function validTaskDueIndex(record) {
      let due = record.get('dueAt', null);
      let index = record.get('crmTaskIndex', {});
      return validTaskIndexShape(record) && (
        ((due == null || due == '') && index.dueOrder == 9007199254740991) ||
        (due is timestamp && index.dueOrder == due.toMillis())
      );
    }

    function untouchedLegacyTaskIndex() {
      return !resource.data.keys().hasAny(['crmTaskIndex']) &&
        !request.resource.data.keys().hasAny(['crmTaskIndex']) &&
        request.resource.data.get('dueAt', null) == resource.data.get('dueAt', null) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending');
    }

    function preservedLegacyTaskDueIndex() {
      let oldDue = resource.data.get('dueAt', null);
      let prior = resource.data.get('crmTaskIndex', {});
      let next = request.resource.data.get('crmTaskIndex', {});
      return !(oldDue is timestamp) && oldDue != null && oldDue != '' &&
        prior is map && next is map && prior.get('version', 0) == 1 && prior.get('issue', 'missing') == null &&
        request.resource.data.get('dueAt', null) == oldDue &&
        next.get('dueOrder', null) == prior.get('dueOrder', null) &&
        validTaskIndexShape(request.resource.data);
    }

    function canReadChat(chatId) {
      return canReadCommercialRecord(
        get(/databases/$(database)/documents/chats/$(chatId)).data.tenantId,
        get(/databases/$(database)/documents/chats/$(chatId)).data
      );
    }

    match /users/{uid} {
      // Nao usar isActive/isOwner aqui para evitar ciclo de avaliacao no proprio users/{uid}.
      allow read: if isSelf(uid) || isAdmin();
      // Cadastro e campos de autorizacao sao criados apenas pelo Admin SDK no servidor.
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "photoURL", "phone", "locale", "updatedAt"
        ])
      );
      allow delete: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAgencyMember() || hasTenantMembership(tenantId);
      allow create, delete: if isAgencyAdmin();
      allow update: if isAgencyAdmin() || (
        canManageTenant(tenantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "responsibleName", "responsibleEmail", "phone", "updatedAt"
        ])
      );
    }

    match /tenant_users/{docId} {
      allow read: if isAgencyMember() || resource.data.userId == myUid();
      // Associacao, papel e bloqueio de usuario passam por API com autorizacao no servidor.
      allow create, update, delete: if isAgencyAdmin();
    }

    match /tenant_settings/{tenantId} {
      allow read: if isAgencyMember() || hasTenantMembership(tenantId);
      allow create, update: if isAgencyMember() || canManageTenant(tenantId);
      allow delete: if isAgencyAdmin();
    }

    match /tenant_entitlements/{tenantId} {
      allow read: if isAgencyMember() || hasTenantMembership(tenantId);
      allow create, update, delete: if isAgencyAdmin();
    }

    match /tenant_channels/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow create: if isAgencyMember() || canManageTenant(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (
        isAgencyMember() || canManageTenant(resource.data.tenantId)
      );
      allow delete: if isAgencyAdmin() || canManageTenant(resource.data.tenantId);
    }

    match /client_contracts/{docId} {
      allow read: if isAgencyAdmin() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /platform_plans/{docId} {
      allow read, write: if isAgencyAdmin();
    }

    match /asaas_checkouts/{docId} {
      allow read, write: if false;
    }

    match /asaas_webhook_events_internal/{docId} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read: if canReadCommercialRecord(resource.data.tenantId, resource.data);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId);
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);

      match /events/{eventId} {
        allow read: if canReadCommercialRecord(
          get(/databases/$(database)/documents/leads/$(leadId)).data.tenantId,
          get(/databases/$(database)/documents/leads/$(leadId)).data
        );
        allow create, update, delete: if canWriteCommercialRecord(
          get(/databases/$(database)/documents/leads/$(leadId)).data.tenantId
        );
      }
    }

    match /chats/{chatId} {
      allow read: if canReadCommercialRecord(resource.data.tenantId, resource.data);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId);
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);
    }

    match /messages/{messageId} {
      allow read: if canReadChat(resource.data.chatId);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId);
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);
    }

    match /chat_notes/{noteId} {
      allow read: if canReadCommercialRecord(resource.data.tenantId, resource.data);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId);
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);
    }

    match /lead_notes/{noteId} {
      allow read: if canReadCommercialRecord(resource.data.tenantId, resource.data);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId);
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);
    }

    match /lead_tasks/{taskId} {
      allow read: if canReadCommercialRecord(resource.data.tenantId, resource.data);
      allow create: if canWriteCommercialRecord(request.resource.data.tenantId) && (
        !requiresTaskIndexWrites(request.resource.data.tenantId) || validTaskDueIndex(request.resource.data)
      );
      allow update: if tenantIdIsUnchanged() && canWriteCommercialRecord(resource.data.tenantId) && (
        !requiresTaskIndexWrites(resource.data.tenantId) || validTaskDueIndex(request.resource.data) ||
        untouchedLegacyTaskIndex() || preservedLegacyTaskDueIndex()
      );
      allow delete: if canWriteCommercialRecord(resource.data.tenantId);
    }

    match /pipeline/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow create: if isAgencyMember() || canManageTenant(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (
        isAgencyMember() || canManageTenant(resource.data.tenantId)
      );
      allow delete: if isAgencyAdmin();
    }

    match /kb_docs/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow create: if isAgencyMember() || canManageTenant(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (
        isAgencyMember() || canManageTenant(resource.data.tenantId)
      );
      allow delete: if isAgencyAdmin();
    }

    match /chat_state/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /ai_logs/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /automations/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow create: if isAgencyMember() || canManageTenant(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (
        isAgencyMember() || canManageTenant(resource.data.tenantId)
      );
      allow delete: if isAgencyAdmin();
    }

    match /jobs/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /metrics/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /capture_forms/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow create: if isAgencyMember() || canManageTenant(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (
        isAgencyMember() || canManageTenant(resource.data.tenantId)
      );
      allow delete: if isAgencyAdmin();
    }

    match /capture_submissions/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /whatsapp_webhook_events/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /meta_webhook_events/{docId} {
      allow read: if isAgencyMember() || hasTenantMembership(resource.data.tenantId);
      allow write: if false;
    }

    match /clientes/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update: if ownerIdIsUnchanged() && (isAdmin() || isOwner(resource.data.ownerId));
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /projetos/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update: if ownerIdIsUnchanged() && (isAdmin() || isOwner(resource.data.ownerId));
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /orcamentos/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId) || hasTenantMembership(resource.data.tenantId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId) || hasTenantMembership(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && ownerIdIsUnchanged() && (
        isAdmin() || isOwner(resource.data.ownerId) || hasTenantMembership(resource.data.tenantId)
      );
      allow delete: if isAdmin() || isOwner(resource.data.ownerId) || hasTenantMembership(resource.data.tenantId);
    }

    match /financeiro/{docId} {
      allow read: if isAdmin() ||
        isOwner(resource.data.ownerId) ||
        isOwner(resource.data.vendedorId) ||
        hasTenantMembership(resource.data.tenantId);
      allow create: if isAdmin() ||
        hasTenantMembership(request.resource.data.tenantId);
      allow update: if tenantIdIsUnchanged() && (isAdmin() ||
        hasTenantMembership(resource.data.tenantId));
      allow delete: if isAdmin() || hasTenantMembership(resource.data.tenantId);
    }

    match /atividades/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update: if ownerIdIsUnchanged() && (isAdmin() || isOwner(resource.data.ownerId));
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Agent OS é acessado exclusivamente por handlers autenticados no servidor.
    // O bloqueio explícito impede acesso direto pelo SDK enquanto as superfícies
    // de cliente, papéis e políticas por tenant ainda são entregues por fases.
    match /agent_missions/{docId} { allow read, write: if false; }
    match /agent_tasks/{docId} { allow read, write: if false; }
    match /agent_runs/{docId} { allow read, write: if false; }
    match /agent_approvals/{docId} { allow read, write: if false; }
    match /agent_approval_policies/{docId} { allow read, write: if false; }
    match /agent_command_messages/{docId} { allow read, write: if false; }
    match /agent_conversations/{docId} { allow read, write: if false; }
    match /agent_domain_events/{docId} { allow read, write: if false; }
    match /agent_mission_evidence/{docId} { allow read, write: if false; }
    match /agent_objectives/{docId} { allow read, write: if false; }
    match /agent_programs/{docId} { allow read, write: if false; }
    match /agent_ideas/{docId} { allow read, write: if false; }
    match /agent_memories/{docId} { allow read, write: if false; }
    match /agent_experiments/{docId} { allow read, write: if false; }
    match /agent_runtime_dispatches/{docId} { allow read, write: if false; }
    match /agent_runtime_events/{docId} { allow read, write: if false; }
    match /agent_task_executions/{docId} { allow read, write: if false; }
    match /tool_providers/{docId} { allow read, write: if false; }
    match /tool_connections/{docId} { allow read, write: if false; }
    match /brand_profiles/{docId} { allow read, write: if false; }
    match /brand_assets/{docId} { allow read, write: if false; }
    match /creative_projects/{docId} { allow read, write: if false; }
    match /creative_jobs/{docId} { allow read, write: if false; }
    match /creative_outputs/{docId} { allow read, write: if false; }
    match /creative_assets/{docId} { allow read, write: if false; }
    match /content_plans/{docId} { allow read, write: if false; }
    match /content_items/{docId} { allow read, write: if false; }
    match /avatar_profiles/{docId} { allow read, write: if false; }
    match /avatar_profiles/{avatarId}/{document=**} { allow read, write: if false; }
    match /avatar_jobs/{docId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
