rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myUid()));
    }

    function myRole() {
      return myUserDoc().data.role;
    }

    function myStatus() {
      return myUserDoc().data.status;
    }

    function isActive() {
      return signedIn() && myUserDoc().exists() && myStatus() == "active";
    }

    function isAdmin() {
      return isActive() && myRole() == "admin";
    }

    function isSelf(uid) {
      return signedIn() && uid == myUid();
    }

    function isOwner(ownerId) {
      return isActive() && ownerId == myUid();
    }

    function canReadChat(chatId) {
      return isAdmin() ||
        (
          isActive() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == myUid()
        );
    }

    match /users/{uid} {
      // Nao usar isActive/isOwner aqui para evitar ciclo de avaliacao no proprio users/{uid}.
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update: if isAdmin() || isOwner(resource.data.ownerId);
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);

      match /events/{eventId} {
        allow read, create: if isAdmin() || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.ownerId);
        allow update, delete: if isAdmin();
      }
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update: if isAdmin() || isOwner(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || canReadChat(resource.data.chatId);
      allow create: if isAdmin() || canReadChat(request.resource.data.chatId);
      allow update, delete: if isAdmin();
    }

    match /clientes/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /projetos/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /orcamentos/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /financeiro/{docId} {
      allow read: if isAdmin() ||
        isOwner(resource.data.ownerId) ||
        isOwner(resource.data.vendedorId);
      allow create, update, delete: if isAdmin();
    }

    match /atividades/{docId} {
      allow read: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if isAdmin() || isOwner(request.resource.data.ownerId);
      allow update, delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
